# Base de dados PostgreSQL — usar Neon (https://neon.tech) em produção
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# JWT — gerar com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_REFRESH_SECRET="change-me-to-another-long-random-secret"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# Cloudinary (upload de fotos — recomendado em produção)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Email
EMAIL_FROM="noreply@rungundum.com"

# Servidor
PORT=3001
NODE_ENV=production

# URL do frontend em produção (domínio na Hostinger)
CLIENT_URL="https://rungundum.com"
SERVER_URL="https://rungundum.com"

# Admin da plataforma
PLATFORM_ADMIN_EMAIL="danielmotaviegas@gmail.com"
