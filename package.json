{
  "name": "raidmanager",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": ["server", "client"],
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,magenta \"npm -w server run dev\" \"npm -w client run dev\"",
    "build": "npm install --include=dev && npm -w client run build && npm -w server run build",
    "start": "NODE_ENV=production node server/dist/index.js",
    "db:migrate": "npm -w server run db:migrate",
    "db:seed": "npm -w server run db:seed",
    "db:studio": "npm -w server run db:studio"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "overrides": {
    "shell-quote": "^1.9.0"
  }
}
